#cloud-config
# First-boot setup for the Aether Stream server (M2 and M4). Mirrors Phase 1 sections 7.2 to 7.7.
# Runs once, on first boot. Output: /var/log/cloud-init-output.log (look for "[aether-setup]").
# Rendered by Terraform templatefile(): dollar-brace placeholders are Terraform values.

package_update: true
package_upgrade: true
packages:
  - git
  - curl
  - unattended-upgrades
  - cifs-utils
  - smbclient

users:
  - name: ${deploy_user}
    groups: [sudo]
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: true
    ssh_authorized_keys:
      - ${ssh_public_key}

write_files:
  # Key-only SSH, no root login. "10-" sorts before cloud-init's "50-cloud-init.conf",
  # and sshd keeps the first value it reads for each setting.
  - path: /etc/ssh/sshd_config.d/10-hardening.conf
    permissions: "0644"
    content: |
      PermitRootLogin no
      PasswordAuthentication no
      KbdInteractiveAuthentication no

  # Storage Box login for the read-only public mount (Phase 1 section 7.3).
  - path: /root/.smbcredentials-public
    permissions: "0600"
    owner: root:root
    content: |
      username=${smb_username}
      password=${smb_password}

  # Storage Box login for the read-only private mount (empty unless enable_private is true).
  - path: /root/.smbcredentials-private
    permissions: "0600"
    owner: root:root
    content: |
      username=${smb_private_username}
      password=${smb_private_password}

  # Docker waits for the mounts, so containers never start on an empty folder.
  - path: /etc/systemd/system/docker.service.d/10-wait-for-mount.conf
    permissions: "0644"
    content: |
      [Unit]
      RequiresMountsFor=${media_mounts}

  # Staged here, then moved to /opt/aether-stream/.env once the repo is cloned.
  # TUNNEL_TOKEN is empty unless enable_tunnel is true (M6). The PRIVATE_* values and
  # COMPOSE_PROFILES are empty unless enable_private is true (M7).
  - path: /var/lib/aether-stream/env
    permissions: "0600"
    owner: root:root
    content: |
      SITE_PASSWORD=${site_password}
      TUNNEL_TOKEN=${tunnel_token}
      PRIVATE_SITE_PASSWORD=${private_site_pw}
      PRIVATE_TUNNEL_TOKEN=${private_tunnel_token}
      COMPOSE_PROFILES=${compose_profiles}

  - path: /usr/local/sbin/aether-setup.sh
    permissions: "0755"
    content: |
      #!/usr/bin/env bash
      # Stops at the first error, so a failed step is visible in the log and the
      # ready marker below is never written.
      set -euo pipefail
      log() { echo "[aether-setup] $*"; }

      # mount_share <mount point> <//host/share> <credentials file>
      # The first CIFS mount can fail with "No route to host" and then succeed, so retry.
      mount_share() {
        local target="$1" share="$2" cred="$3" attempt mounted=0
        mkdir -p "$target"
        grep -q " $target " /etc/fstab || echo "$share $target cifs credentials=$cred,ro,file_mode=0444,dir_mode=0555,vers=3.0,_netdev,nofail 0 0" >> /etc/fstab
        systemctl daemon-reload
        for attempt in 1 2 3 4 5; do
          if mount "$target"; then mounted=1; break; fi
          log "mount of $target failed (attempt $attempt), retrying in 10 seconds"
          sleep 10
        done
        if [ "$mounted" != 1 ]; then log "mount of $target failed after 5 attempts"; exit 1; fi
        findmnt "$target"
      }

      log "mounting the public library at /media/videos"
      mount_share /media/videos '//${smb_host}/${smb_username}' /root/.smbcredentials-public

      if [ "${enable_private}" = "true" ]; then
        log "mounting the private library at /media/private"
        mount_share /media/private '//${smb_private_host}/${smb_private_username}' /root/.smbcredentials-private
      fi

      log "cloning ${repo_url} (${repo_branch})"
      git clone --depth 1 --branch '${repo_branch}' '${repo_url}' /opt/aether-stream
      chown -R ${deploy_user}:${deploy_user} /opt/aether-stream
      install -m 600 -o ${deploy_user} -g ${deploy_user} /var/lib/aether-stream/env /opt/aether-stream/.env
      shred -u /var/lib/aether-stream/env

      log "installing Docker and FFmpeg"
      DOCKER_USER=${deploy_user} bash /opt/aether-stream/bootstrap.sh

      log "starting: ${compose_services}"
      sudo -u ${deploy_user} -H bash -c 'cd /opt/aether-stream && docker compose up -d --build ${compose_services}'
      sudo -u ${deploy_user} -H docker compose -f /opt/aether-stream/docker-compose.yml ps

      touch /var/lib/aether-stream-ready
      log "done"

runcmd:
  - systemctl restart ssh
  - /usr/local/sbin/aether-setup.sh

final_message: "Aether Stream cloud-init finished after $UPTIME seconds"
