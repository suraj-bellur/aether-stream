# Copy this file to ".env" and fill in the values. ".env" is git-ignored (it holds secrets).
# One KEY=value per line, no spaces around "=", no comments after a value.
# Windows paths use forward slashes: E:/Media (not E:\Media).
# After changing a folder or COMPOSE_PROFILES run "vagrant reload"; then, in the VM:
#   cd /vagrant && docker compose up -d && docker compose restart nginx

# ---------------------------------------------------------------------------
# PUBLIC SITE   (your-public-hostname)
# ---------------------------------------------------------------------------
# Windows folder the public site serves (videos and photos, any folder depth)
PUBLIC_MEDIA_DIR=E:/
SITE_PASSWORD=your_secure_password_here
# Cloudflare tunnel token of the public tunnel (see CLOUDFLARE.md)
TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# ---------------------------------------------------------------------------
# PRIVATE SITE   - optional
# ---------------------------------------------------------------------------
# THE ON/OFF SWITCH:  private  = site is on     (empty) = site is off
# To turn it off completely, empty this line, run "vagrant reload", then stop it with:
#   docker compose rm -sf backend-private nginx-private cloudflared-private
COMPOSE_PROFILES=
# Windows folder the private site serves. It must be DIFFERENT from PUBLIC_MEDIA_DIR and
# NEITHER may be inside the other (each site scans its folder recursively).
PRIVATE_MEDIA_DIR=
# Use a different password from the public one
PRIVATE_SITE_PASSWORD=
# Token of the separate private tunnel (see CLOUDFLARE.md)
PRIVATE_TUNNEL_TOKEN=

# ---------------------------------------------------------------------------
# More settings (all optional): login lengths and lockouts, rescan time and the thumbnail
# speed limit all have defaults. See the table under "Settings (.env)" in README.md.
# ---------------------------------------------------------------------------
